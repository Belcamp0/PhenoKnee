# Security headers for Netlify (and Cloudflare Pages).
# This file alone is sufficient — netlify.toml carries the same rules, so
# whichever of the two is present, the protections apply.

/*
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'none'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY

/index.html
  Cache-Control: public, max-age=0, must-revalidate
